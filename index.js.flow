type ShowOptions = {|
  clientToken: string,
  threeDSecure?: {|
    amount: number,
  |},
  vaultManager?: boolean,
  cardDisabled?: boolean,
  googlePay?: boolean,
  orderTotal?: string,
  currencyCode?: string,
  googlePayMerchantId?: string,
  payPal?: boolean,
  applePay?: boolean,
  merchantIdentifier?: string,
  countryCode?: string,
  merchantName?: string,
  darkTheme?: boolean,
  fontFamily?: string,
  boldFontFamily?: string,
|};

type CardInfo = {|
  number: string,
  expirationMonth: string,
  expirationYear: string,
  cvv: string,
  postalCode: string,
|};

type ShowResult = {|
  nonce: string,
  description: string,
  type: string,
  isDefault: boolean,
  deviceData: string,
|};

/**
 * Result of `tokenizePayPal`. Narrower than `ShowResult`: the iOS implementation no
 * longer collects device data, and `isDefault` was only meaningful for Drop-in's
 * vault manager.
 */
type PayPalResult = {|
  nonce: string,
  description: string,
  type: string,
|};

declare module.exports: {
  tokenizePayPal: (clientToken: string) => Promise<PayPalResult>,
  /** Android only. Rejects on iOS — the Drop-in SDK has been removed there. */
  show: (options: ShowOptions) => Promise<ShowResult>,
  /** Android only. */
  fetchMostRecentPaymentMethod: (clientToken: string) => Promise<ShowResult>,
  tokenizeCard: (clientToken: string, cardInfo: CardInfo) => Promise<string>,
};
